# Server-only. Never prefix these with VITE_ — they must not reach the client.
GROQ_API_KEY=
STRIPE_SECRET_KEY=

# true = static placeholder copy, no Groq call.
# npm run dev defaults this to true when unset. Set false to call Groq locally.
USE_MOCK_GENERATE=true

# Production rate limit: 5 generate requests / IP / minute.
# When unset: mock mode skips Redis; real mode uses a process-local in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Safe to expose: Stripe.js publishable key, used later with the embedded Payment Element.
VITE_STRIPE_PUBLISHABLE_KEY=
